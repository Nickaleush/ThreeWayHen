<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_common_bg"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/resultPanel"
        android:layout_width="326dp"
        android:layout_height="@dimen/result_panel_height"
        android:layout_gravity="center"
        android:background="@drawable/bg_result_panel"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Содержимое панели -->
        <LinearLayout
            android:id="@+id/resultContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="60dp"
            android:paddingEnd="18dp"
            android:paddingBottom="14dp">

            <threeway.henroute.orchard.core.ui.OutlinedTextView
                android:id="@+id/titleTextView"
                style="@style/HenTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="YOU WIN!"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:visibility="gone" />

            <!-- Звёзды -->
            <LinearLayout
                android:id="@+id/starsRow"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/starOne"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_star_active" />

                <ImageView
                    android:id="@+id/starTwo"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="2dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_star_active" />

                <ImageView
                    android:id="@+id/starThree"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="2dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_star_inactive" />

            </LinearLayout>

            <threeway.henroute.orchard.core.ui.OutlinedTextView
                android:id="@+id/subtitleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:shadowColor="@color/transparent"
                android:textColor="@color/hen_brown"
                android:textSize="12sp"
                android:visibility="gone" />

            <threeway.henroute.orchard.core.ui.OutlinedTextView
                android:id="@+id/statsTextView"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />

            <!-- Награды -->
            <LinearLayout
                android:id="@+id/rewardsRow"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_hud_pill"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp">

                    <threeway.henroute.orchard.core.ui.OutlinedTextView
                        android:id="@+id/rewardTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:shadowColor="@color/transparent"
                        android:text="+123"
                        android:textColor="@color/hen_brown"
                        android:textSize="16sp" />

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_marginStart="3dp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_coin" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_hud_pill"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp">

                    <threeway.henroute.orchard.core.ui.OutlinedTextView
                        android:id="@+id/featherRewardTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:shadowColor="@color/transparent"
                        android:text="+345"
                        android:textColor="@color/hen_brown"
                        android:textSize="16sp" />

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_marginStart="3dp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icon_feather" />

                </LinearLayout>

            </LinearLayout>

            <threeway.henroute.orchard.core.ui.OutlinedTextView
                android:id="@+id/bestTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="@color/transparent"
                android:textColor="@color/hen_brown"
                android:textSize="10sp"
                android:visibility="gone" />

            <!-- Нижние кнопки -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="7dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/menuButton"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:contentDescription="@string/result_home"
                    android:scaleType="fitCenter"
                    android:src="@drawable/home_button" />

                <ImageView
                    android:id="@+id/restartButton"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/result_replay"
                    android:scaleType="fitCenter"
                    android:src="@drawable/restart_button"
                    android:visibility="gone" />

                <threeway.henroute.orchard.core.ui.OutlinedButton
                    android:id="@+id/nextButton"
                    style="@style/HenButton.Primary"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/result_next"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Логотип поверх верхней части панели -->
        <ImageView
            android:id="@+id/winLogoImageView"
            android:layout_width="270dp"
            android:layout_height="120dp"
            android:layout_gravity="top|center_horizontal"
            android:contentDescription="@null"
            android:elevation="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/you_win_logo"
            android:translationY="-58dp" />

    </FrameLayout>

</FrameLayout>