<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="210dp"
    android:layout_columnWeight="1"
    android:layout_margin="5dp"
    android:background="@drawable/item_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="9dp">

    <ImageView
        android:id="@+id/artworkImageView"
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:contentDescription="@string/splash_image_description"
        android:scaleType="fitCenter" />

    <threeway.henroute.orchard.core.ui.OutlinedTextView
        android:id="@+id/titleTextView"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:gravity="center"
        android:maxLines="1"
        android:shadowColor="@color/transparent"
        android:textColor="@color/hen_brown"
        android:textSize="11sp" />

    <threeway.henroute.orchard.core.ui.OutlinedTextView
        android:id="@+id/descriptionTextView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:shadowColor="@color/transparent"
        android:textColor="#6D573A"
        android:textSize="8sp" />

    <threeway.henroute.orchard.core.ui.OutlinedButton
        android:id="@+id/actionButton"
        style="@style/HenButton.Primary"
        android:layout_width="110dp"
        android:layout_height="36dp"
        android:minHeight="0dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:textSize="9sp" />
</LinearLayout>
