<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <threeway.henroute.orchard.games.hen.HenGameView
        android:id="@+id/gameView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="7dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1.15"
                android:background="@drawable/bg_hud_pill"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="5dp"
                android:paddingEnd="5dp">

                <ImageView
                    android:id="@+id/heartOne"
                    android:layout_width="24dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_heart" />

                <ImageView
                    android:id="@+id/heartTwo"
                    android:layout_width="24dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="1dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_heart" />

                <ImageView
                    android:id="@+id/heartThree"
                    android:layout_width="24dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="1dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_heart" />

                <threeway.henroute.orchard.core.ui.OutlinedTextView
                    android:id="@+id/livesTextView"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_hud_pill"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    android:src="@drawable/icon_feather" />

                <threeway.henroute.orchard.core.ui.OutlinedTextView
                    android:id="@+id/feathersTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="1dp"
                    android:shadowColor="@color/transparent"
                    android:text="0"
                    android:textColor="@color/hen_brown"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/coin_pill_bg"
                android:gravity="center"
                android:orientation="horizontal">

                <threeway.henroute.orchard.core.ui.OutlinedTextView
                    android:id="@+id/coinsTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="1dp"
                    android:shadowColor="@color/transparent"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
            </LinearLayout>

            <threeway.henroute.orchard.core.ui.OutlinedTextView
                android:id="@+id/levelTextView"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_hud_pill"
                android:gravity="center"
                android:shadowColor="@color/transparent"
                android:text="LVL 1"
                android:textColor="@color/hen_brown"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <threeway.henroute.orchard.core.ui.OutlinedTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DISTANCE"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <FrameLayout
                android:id="@+id/progressTrackContainer"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1">

                <ProgressBar
                    android:id="@+id/distanceProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="13dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_achievement" />

                <ImageView
                    android:id="@+id/progressHenImageView"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center_vertical|start"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_progress_hen" />
            </FrameLayout>

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginStart="3dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_finish" />

            <threeway.henroute.orchard.core.ui.OutlinedTextView
                android:id="@+id/progressPercentTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="0%"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <threeway.henroute.orchard.core.ui.OutlinedTextView
                android:id="@+id/distanceTextView"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />

            <threeway.henroute.orchard.core.ui.OutlinedTextView
                android:id="@+id/timerTextView"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />

            <threeway.henroute.orchard.core.ui.OutlinedTextView
                android:id="@+id/streakTextView"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/laneHintContainer"
        android:layout_width="190dp"
        android:layout_height="62dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="9dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/laneLeftArrow"
            android:layout_width="58dp"
            android:layout_height="46dp"
            android:contentDescription="@string/game_route_left"
            android:scaleType="fitCenter"
            android:src="@drawable/lane_arrow_left" />

        <ImageView
            android:id="@+id/laneCenterArrow"
            android:layout_width="58dp"
            android:layout_height="46dp"
            android:layout_marginStart="5dp"
            android:contentDescription="@string/game_route_center"
            android:scaleType="fitCenter"
            android:src="@drawable/lane_arrow_up" />

        <ImageView
            android:id="@+id/laneRightArrow"
            android:layout_width="58dp"
            android:layout_height="46dp"
            android:layout_marginStart="5dp"
            android:contentDescription="@string/game_route_right"
            android:scaleType="fitCenter"
            android:src="@drawable/lane_arrow_right" />
    </LinearLayout>

    <ImageView
        android:id="@+id/pauseButton"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:contentDescription="@string/game_paused_title"
        android:src="@drawable/pause_button" />

    <FrameLayout
        android:id="@+id/pausePanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/screen_common_bg"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="326dp"
            android:layout_height="330dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_result_panel"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <threeway.henroute.orchard.core.ui.OutlinedTextView
                style="@style/HenTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/game_paused_title"
                android:textAllCaps="true"
                android:textColor="@color/hen_brown"
                android:textSize="27sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/homeButton"
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:contentDescription="@string/game_home"
                    android:src="@drawable/home_button" />

                <ImageView
                    android:id="@+id/replayButton"
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:layout_marginStart="12dp"
                    android:contentDescription="@string/game_replay"
                    android:src="@drawable/restart_button" />

                <ImageView
                    android:id="@+id/continueButton"
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:layout_marginStart="12dp"
                    android:contentDescription="@string/game_continue"
                    android:src="@drawable/play_button" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
